# Signing keys — never commit
*.pem

# Release tooling scratch
scripts/node_modules/
scripts/.staging/

# Dev tooling — puppeteer-core + chromium-bidi for the Edge CDP debug helper.
# ~40 MB of native modules that have no business in the published extension.
# scripts/release.sh strips dev/ at package time; this prevents accidental commit.
dev/node_modules/

# Playwright MCP session logs / snapshots (generated in module dev folders)
**/.playwright-mcp/

# OS / editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/

# Built artifacts (created by scripts/release.sh into /tmp, never here, but
# guard against accidental in-tree builds)
apaisuite-*.zip
apaisuite-*.crx

# Dev capture dumps — these have carried real bearer tokens and internal UPNs.
digitallocks-*.json
*-probe.json
*-capture.json

# Screenshots taken against LIVE reports show real associate names — the
# digitalmetrics grid renders ~60 of them per frame, and this repo is public.
# The handful already tracked predate this rule and stay tracked; anything new
# needs `git add -f` and a look at what is actually in the frame first.
dev/screenshots/*.png
# Print probes render the roster to PDF — same names, same rule.
dev/screenshots/*.pdf

# Local tooling only — playwright for dev/cws-drive.mjs, never shipped.
node_modules/

# Recovered source dumps from dev/web-grep.mjs — internal app code, not ours.
dev/web-*.txt

# Incident Intake — LOCAL ONLY for now (not registered in the repo's _registry.js;
# registered only in the APAISuite-dev mirror the debug Edge loads). Keeps the
# scanner helper, gateway test and any scans/models out of the public repo.
modules/incidentintake/
dev/intake-helper.py
dev/gateway-ocr-test.py
dev/scan-*.py
dev/packet-status.py
dev/win-ocr.ps1
dev/trocr-test.mjs
dev/.models/
dev/.intake/
dev/pack-local.sh
dev/OTHER-PC-SETUP.md
dev/local-registration.patch
dev/.intake-helper.log
dev/probe-ii-*.mjs
dev/video-helper.py

# Probe outputs and caches carrying live store data — associate names and
# punches (GTA), claims payloads, CX customer comments, report screenshots.
# The scripts that produced them are committed; their captures never are.
dev/.cache/
dev/.claim-probe/
dev/.gta-cache-*.json
dev/.gta-survey.json
dev/__pycache__/
dev/*.png
gta-survey-*.png
dev/cx-hoops-comments-*.json
dev/cx-replay2.json
dev/clearsight-intake-catalog.json
dev/clearsight-intake-lookups.json
