{
  "manifest_version": 3,
  "name": "APAISuite",
  "short_name": "APAISuite",
  "version": "0.9.2",
  "description": "Asset Protection investigation suite: case review, ORC monitoring, Spark fraud triage, digital locks, and store metrics.",
  "minimum_chrome_version": "120",
  "action": {
    "default_title": "Open APAISuite",
    "default_icon": {
      "16": "assets/icons/suite-16.png",
      "32": "assets/icons/suite-32.png",
      "48": "assets/icons/suite-48.png",
      "128": "assets/icons/suite-128.png"
    }
  },
  "icons": {
    "16": "assets/icons/suite-16.png",
    "32": "assets/icons/suite-32.png",
    "48": "assets/icons/suite-48.png",
    "128": "assets/icons/suite-128.png"
  },
  "background": {
    "service_worker": "background/service_worker.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "scripting",
    "windows",
    "clipboardWrite",
    "webRequest",
    "cookies",
    "downloads",
    "debugger",
    "browsingData",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://radapps3.wal-mart.com/Protected/CaseVisibility/*",
    "https://ivrattcloud-prod.wal-mart.com/*",
    "https://app.us.auror.co/*",
    "https://*.auror.co/*",
    "https://wmtus.apprissretailcloud.com/*",
    "https://workvivo.walmart.com/*",
    "https://www.walmart.com/*",
    "https://one.walmart.com/*",
    "https://sf-reports-ui.walmart.com/*",
    "https://sf-reports-api.walmart.com/*",
    "https://hoops.wal-mart.com/*",
    "https://api.hoops.wal-mart.com/*",
    "https://pfedprod.wal-mart.com/*",
    "https://prod.liveaccess.invue.walmart.com/*",
    "https://gscope.walmartlabs.com/*",
    "https://gscope.walmart.com/*",
    "https://swift.walmart.com/*",
    "https://i5.walmartimages.com/*",
    "https://i.walmartimages.com/*",
    "https://storage.googleapis.com/cas_storage/*",
    "https://qrcallbox.com/*",
    "https://datastudio.google.com/*",
    "https://lookerstudio.google.com/*",
    "https://apscpi.wal-mart.com/*",
    "https://app.powerbi.com/*",
    "https://*.pbidedicated.windows.net/*",
    "https://*.analysis.windows.net/*",
    "https://stores.tableau.wal-mart.com/*",
    "https://go.enviance.com/*",
    "https://firestore.googleapis.com/*",
    "https://identitytoolkit.googleapis.com/*",
    "https://securetoken.googleapis.com/*",
    "https://api-*.sendbird.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://sf-reports-ui.walmart.com/mumd/*"
      ],
      "js": [
        "modules/assocpurchases/content/mumd_capture.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://radapps3.wal-mart.com/Protected/CaseVisibility/*"
      ],
      "js": [
        "modules/closinglist/content/casevisibility.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://radapps3.wal-mart.com/Protected/CaseVisibility/*"
      ],
      "js": [
        "modules/stockingplan/content/casevisibility.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://ivrattcloud-prod.wal-mart.com/*"
      ],
      "js": [
        "modules/closinglist/content/ivr.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://gscope.walmartlabs.com/mfe/ordermanagement/orderresolution*"
      ],
      "js": [
        "modules/digitallocks/content/gscope_capture.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://gscope.walmartlabs.com/mfe/ordermanagement/orderresolution*",
        "https://gscope.walmartlabs.com/mfe/spark/dashboard*"
      ],
      "js": [
        "modules/sparkfraud/content/capture.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://app.powerbi.com/*"
      ],
      "js": [
        "modules/digitallocks/content/capture.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://go.enviance.com/CustomApp/*"
      ],
      "js": [
        "modules/livedashboard/content/enviance_capture.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://app.powerbi.com/*"
      ],
      "js": [
        "modules/livedashboard/content/powerbi_register_capture.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://app.powerbi.com/*"
      ],
      "js": [
        "modules/livedashboard/content/powerbi_recognition_capture.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://app.us.auror.co/*",
        "https://*.auror.co/*"
      ],
      "js": [
        "modules/aurorbuddy/content/secure_pill.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://stores.tableau.wal-mart.com/*"
      ],
      "js": [
        "modules/metricshot/content/tableau_capture.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://stores.tableau.wal-mart.com/*"
      ],
      "js": [
        "modules/vizpick/content/tableau_capture.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "app.html",
        "app.js",
        "assets/*",
        "styles/*",
        "shared/*",
        "modules/*"
      ],
      "matches": [
        "https://app.us.auror.co/*",
        "https://*.auror.co/*"
      ]
    }
  ]
}
