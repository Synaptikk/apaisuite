rules_version = '2';

// Digital Metrics — Firestore rules for the `digitalmetrics` database in the
// `apaisuite` project. LIVE: deployed via `firebase deploy --only
// firestore:digitalmetrics` from unified-extension-suite/ (see backend/README.md).
//
// Every path change in lib/firestore.js needs a matching edit here AND a
// redeploy; the rules are not read at runtime, so an un-deployed edit shows up
// only as 403 PERMISSION_DENIED in the SW console (2026-09-14: the
// stores/{store}/classifications move sat undeployed for eight days).
//
// The legacy standalone project ran `allow read, write: if true`. These rules
// assume the encrypted schema in docs/DIGITAL_METRICS_SCHEMA.md.
//
// Honest limits of what rules can enforce here:
//   • Rules cannot iterate arrays, so "no element of associates[] carries a
//     plaintext name" is NOT expressible. That guarantee is enforced
//     client-side by lib/codec.js allowlists + assertNoPlaintextNames().
//     What rules CAN do is refuse any document not stamped as the encrypted
//     schema version, which stops a legacy-shape writer dead.
//   • Anonymous auth means "signed in" is a low bar — it stops drive-by
//     scraping and casual deletion, not a determined party. Combined with
//     client-side encryption, names stay protected either way. If this data
//     ever needs real access control, move to named accounts and gate on
//     custom claims (store assignment) here.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────
    function signedIn() {
      return request.auth != null;
    }

    // Every document this module writes carries the encrypted-schema stamp.
    // Refusing anything older is what prevents a stale client from writing
    // plaintext names back into a clean database.
    function encryptedSchema() {
      return request.resource.data.schemaVersion is int
          && request.resource.data.schemaVersion >= 2;
    }

    function validStore(store) {
      return store is string && store.size() > 0 && store.size() <= 10;
    }

    // Documents keyed by an ISO date (YYYY-MM-DD).
    function validDateKey(key) {
      return key.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    // ── Suite-wide metadata ──────────────────────────────────────────────
    match /metrics/stores {
      allow read:  if signedIn();
      allow write: if signedIn() && request.resource.data.list is list;
    }

    // LEGACY. Classifications moved to stores/{store}/classifications/current
    // (2026-09-06) after installs at different stores kept rewriting this one
    // shared map. Still readable as a one-time seed for a store with no map of
    // its own; never written again.
    match /metrics/classifications {
      allow read:  if signedIn();
      allow write: if false;
    }

    // ── Per-store data ───────────────────────────────────────────────────
    match /stores/{store} {
      allow read: if signedIn() && validStore(store);
      // The store document itself is a container; subcollections hold the data.
      allow write: if false;

      match /weeks/{weekStart} {
        allow read:  if signedIn();
        allow write: if signedIn() && encryptedSchema()
                     && validDateKey(weekStart)
                     && request.resource.data.rawData is list;
      }

      match /schedules/{date} {
        allow read:  if signedIn();
        allow write: if signedIn() && encryptedSchema()
                     && validDateKey(date)
                     && request.resource.data.associates is list;
      }

      match /dailyAssignments/{date} {
        allow read: if signedIn();

        // Finalised days are locked. Unfinalising is deliberately allowed so a
        // mistake is recoverable, but editing the roster of a finalised day
        // without first unfinalising it is not.
        allow create: if signedIn() && encryptedSchema() && validDateKey(date)
                      && request.resource.data.associates is list;

        allow update: if signedIn() && encryptedSchema()
                      && request.resource.data.associates is list
                      && (resource.data.finalized != true
                          || request.resource.data.finalized == false);

        allow delete: if false;
      }

      match /classifications/{doc} {
        allow read:  if signedIn();
        // data is { <token>: { c, n } } — a map keyed by HMAC token, never a name.
        allow write: if signedIn() && encryptedSchema()
                     && doc == 'current'
                     && request.resource.data.data is map;
      }

      // modules/safetyobs: observations submitted from the suite, per day.
      match /safetyObs/{date} {
        allow read:  if signedIn();
        allow write: if signedIn() && encryptedSchema()
                     && validDateKey(date)
                     && request.resource.data.entries is list;
      }

      // modules/digitalschedule: the store's shared ScheduleRight rules. Both
      // fields are sealed blobs (lib/codec.js encodeScheduleRules).
      match /scheduleRules/{doc} {
        allow read:  if signedIn();
        allow write: if signedIn() && encryptedSchema()
                     && doc == 'current'
                     && request.resource.data.rulesSealed is string
                     && request.resource.data.areasSealed is string;
      }

      match /suggestions/{date} {
        allow read:  if signedIn();
        // Machine-generated; keyed by token, carries no `n` ciphertext at all.
        allow write: if signedIn() && encryptedSchema()
                     && validDateKey(date)
                     && request.resource.data.suggestions is map;
      }
    }

    // ── Shared per-slot post claims (shared/post_claims.js) ──────────────
    // One doc per (store, kind, slot, channel) so two installs at a store
    // cannot both post the same scheduled report. Created with an
    // exists:false precondition (the atomic part lives in the client's
    // commit, not here); rules only bound the shape. A "sent" doc can only
    // be rewritten as "sent", so a late/stale client cannot reopen a
    // delivered slot. Never deleted from the client.
    function validClaim() {
      let d = request.resource.data;
      return d.keys().hasOnly(['owner', 'state', 'at', 'leaseUntil', 'messageId',
                               'kind', 'store', 'slot', 'channel', 'error'])
          && d.owner is string && d.owner.size() > 0 && d.owner.size() <= 64
          && d.state in ['sending', 'sent', 'failed']
          && d.at is int && d.leaseUntil is int
          && (d.messageId == null || (d.messageId is string && d.messageId.size() <= 64))
          && d.kind is string && d.kind.size() > 0 && d.kind.size() <= 100
          && validStore(d.store)
          && d.slot is string && d.slot.size() > 0 && d.slot.size() <= 40
          && d.channel is string && d.channel.size() <= 120
          && (!('error' in d) || (d.error is string && d.error.size() <= 200));
    }
    match /postClaims/{id} {
      allow read:   if signedIn() && id.size() <= 400;
      allow create: if signedIn() && id.size() <= 400 && validClaim();
      allow update: if signedIn() && validClaim()
                    && request.resource.data.store == resource.data.store
                    && request.resource.data.kind  == resource.data.kind
                    && request.resource.data.slot  == resource.data.slot
                    && (resource.data.state != 'sent' || request.resource.data.state == 'sent');
      allow delete: if false;
    }

    // Anything not matched above is denied. Never reintroduce a
    // `match /{document=**}` catch-all here.
  }
}
